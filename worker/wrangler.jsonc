{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "task-manager-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "task_manager_db",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ]
}
